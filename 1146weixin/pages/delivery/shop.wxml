<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <block wx:else>
    <!-- 店铺信息 -->
    <view class="shop-detail-header">
      <image wx:if="{{shop.logo}}" class="shop-detail-logo" src="{{shop.logo}}" mode="aspectFill"></image>
      <view class="shop-detail-info">
        <view class="shop-detail-name">
          {{shop.shop_name}}
          <text wx:if="{{shop.accept_order == 0}}" class="shop-badge badge-stop">暂不接单</text>
          <text wx:elif="{{shop.delivery_enabled == 0}}" class="shop-badge badge-self">仅自提</text>
        </view>
        <view wx:if="{{shop.description}}" class="shop-detail-desc">{{shop.description}}</view>
        <view wx:if="{{shop.address}}" class="shop-detail-row">
          <text class="shop-detail-label">地址</text>
          <text class="shop-detail-text">{{shop.address}}</text>
        </view>
        <view wx:if="{{shop.whatsapp}}" class="shop-detail-row">
          <text class="shop-detail-label">WhatsApp</text>
          <text class="shop-detail-text shop-wa" data-wa="{{shop.whatsapp}}" bindtap="onWhatsapp">{{shop.whatsapp}}</text>
        </view>
        <view wx:if="{{shop.business_hours}}" class="shop-detail-row">
          <text class="shop-detail-label">营业时间</text>
          <text class="shop-detail-text">{{shop.business_hours}}</text>
        </view>
      </view>
    </view>

    <!-- 该店铺的外送商品 -->
    <view class="goods-section">
      <view class="goods-section-title">外送商品（{{list.length}}）</view>
      <view wx:if="{{list.length === 0}}" class="goods-empty">该店铺暂无外送商品</view>
      <view wx:for="{{list}}" wx:key="delivery_id" class="goods-card" data-id="{{item.delivery_id}}" bindtap="onOrder">
        <image class="goods-img" src="{{item.image_url}}" mode="aspectFill"></image>
        <view class="goods-body">
          <view class="goods-name">
            {{item.title}}
            <text wx:if="{{shop.delivery_enabled == 0}}" class="goods-tag">到店自提</text>
          </view>
          <view wx:if="{{item.description}}" class="goods-desc">{{item.description}}</view>
          <view wx:if="{{item.range_list.length}}" class="goods-range">
            <view class="goods-range-label">配送范围</view>
            <view class="range-box {{item._expanded ? '' : 'collapsed'}}">
              <text wx:for="{{item.range_list}}" wx:for-item="area" wx:key="*this" class="goods-range-tag">{{area}}</text>
            </view>
            <text wx:if="{{item.range_list.length > 6}}" class="goods-range-toggle" data-index="{{index}}" catchtap="toggleRange">{{item._expanded ? '收起' : '展开全部(' + item.range_list.length + ')'}}</text>
          </view>
          <view class="goods-meta">
            <text class="goods-price">RM {{item.price}}</text>
            <text class="goods-fee">配送费 RM {{item.delivery_fee}}</text>
          </view>
          <view class="goods-min">起送 RM {{item.min_order}}</view>
          <view class="goods-order {{shop.accept_order == 0 || shop.delivery_enabled == 0 ? 'disabled' : ''}}">
            {{shop.accept_order == 0 ? '暂不接单' : (shop.delivery_enabled == 0 ? '到店自提' : '立即下单')}}
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

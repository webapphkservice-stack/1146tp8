<view class="container">
  <!-- 登录页 LOGO（后台图标管理设置） -->
  <view class="login-logo" wx:if="{{logo}}">
    <image class="logo-image" src="{{logo}}" mode="aspectFit"></image>
  </view>

  <!-- 登录方式切换 -->
  <view class="login-tabs">
    <view class="tab {{loginType==='wechat'?'active':''}}" data-type="wechat" bindtap="switchLoginType">微信</view>
    <view class="tab {{loginType==='mobile'?'active':''}}" data-type="mobile" bindtap="switchLoginType">手机号码</view>
    <view class="tab {{loginType==='whatsapp'?'active':''}}" data-type="whatsapp" bindtap="switchLoginType">WhatsApp</view>
  </view>

  <!-- 微信登录 -->
  <block wx:if="{{loginType==='wechat'}}">
    <view class="wechatapp" wx:if="{{!isRegister}}">
      <!-- 选择头像 -->
      <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}"></image>
        <view wx:else class="avatar avatar-placeholder">
          <text class="iconfont icon-profile"></text>
        </view>
      </button>
      <view class="avatar-tip">点击头像选择</view>
    </view>

    <view class="auth-title">授权登录</view>
    <view class="auth-subtitle" wx:if="{{!isRegister}}">请设置你的头像和昵称</view>
    <view class="auth-subtitle" wx:else>欢迎回来，点击授权即可登录</view>

    <!-- 填写昵称 -->
    <view class="form-item" wx:if="{{!isRegister}}">
      <text class="label">昵称</text>
              <input class="nickname-input" type="nickname" placeholder="请输入昵称" placeholder-class="ph"
                value="{{nickName}}" bindinput="onNickName" bindblur="onNickName" bind:nicknamereview="onNicknameReview" maxlength="20" />
    </view>

    <view class="login-btn">
      <button class="btn-normal" catchtap="onSubmit">授权登录</button>
    </view>
  </block>

  <!-- 手机号码登录 / 注册 -->
  <block wx:if="{{loginType==='mobile'}}">
    <view class="auth-title">手机号码登录</view>
    <view class="auth-subtitle">未注册手机号码将自动创建账号</view>

    <view class="form-item">
      <text class="label">手机号码</text>
      <input class="nickname-input" type="number" placeholder="请输入手机号码" placeholder-class="ph"
        value="{{mobile}}" bindinput="onMobileInput" maxlength="11" />
    </view>

    <view class="form-item code-item">
      <text class="label">验证码</text>
      <input class="nickname-input" type="number" placeholder="请输入验证码" placeholder-class="ph"
        value="{{mobileCode}}" bindinput="onMobileCodeInput" maxlength="6" />
      <button class="code-btn" disabled="{{mobileCountdown>0}}" bindtap="getMobileCode">{{mobileCodeText}}</button>
    </view>

    <view class="login-btn">
      <button class="btn-normal" catchtap="onMobileSubmit">登录 / 注册</button>
    </view>
  </block>

  <!-- WhatsApp 登录 / 注册 -->
  <block wx:if="{{loginType==='whatsapp'}}">
    <view class="auth-title">WhatsApp 登录</view>
    <view class="auth-subtitle">验证码将通过 WhatsApp 消息下发</view>

    <view class="form-item">
      <text class="label">手机号码</text>
      <input class="nickname-input" type="number" placeholder="含国家码，如 60123456789" placeholder-class="ph"
        value="{{waPhone}}" bindinput="onWaPhoneInput" maxlength="16" />
    </view>

    <view class="form-item code-item">
      <text class="label">验证码</text>
      <input class="nickname-input" type="number" placeholder="请输入验证码" placeholder-class="ph"
        value="{{waCode}}" bindinput="onWaCodeInput" maxlength="6" />
      <button class="code-btn" disabled="{{waCountdown>0}}" bindtap="getWaCode">{{waCodeText}}</button>
    </view>

    <view class="login-btn">
      <button class="btn-normal" catchtap="onWhatsappSubmit">登录 / 注册</button>
    </view>
  </block>

  <view class="no-login-btn">
    <button class="btn-normal" catchtap="onNotLogin">暂不登录</button>
  </view>
</view>

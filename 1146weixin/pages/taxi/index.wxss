.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; box-sizing: border-box; }
.taxi-header { padding: 16rpx 8rpx 24rpx; }
.taxi-title { font-size: 36rpx; font-weight: bold; color: #333; }
.taxi-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.form-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.form-item:last-child { border-bottom: none; }
.label { width: 160rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 28rpx; text-align: right; }
.picker-value { flex: 1; font-size: 28rpx; color: #333; text-align: right; }
.price-box { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; }
.price-label { font-size: 28rpx; color: #666; }
.price-value { font-size: 36rpx; font-weight: bold; color: #f44; }
.empty { text-align: center; color: #999; padding: 80rpx 0; font-size: 28rpx; }
.submit-btn { background: #ff9800; color: #fff; text-align: center; font-size: 32rpx; font-weight: bold; padding: 28rpx 0; border-radius: 16rpx; }
.submit-btn.disabled { opacity: .6; }
.link-btn { text-align: center; color: #666; font-size: 26rpx; padding: 28rpx 0; }
.order-entry { background: #fff7e6; border: 1rpx solid #ffd591; color: #ff9800; text-align: center; font-size: 28rpx; font-weight: bold; padding: 22rpx 0; border-radius: 12rpx; margin-bottom: 20rpx; }

.ticket-header {
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, #07c160, #3eb575);
  color: #fff;
  text-align: center;
}

.ticket-header__label {
  font-size: 28rpx;
  opacity: .9;
}

.ticket-header__num {
  margin-top: 20rpx;
  font-size: 80rpx;
  line-height: 1.1;
  font-weight: bold;
}

.ticket-header__tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  opacity: .85;
}

.ticket-log {
  background: #fff;
}

.ticket-log__title {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.log-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.log-describe {
  font-size: 28rpx;
  color: #333;
}

.log-time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.item-right {
  font-size: 32rpx;
}

.no-more {
  padding: 30rpx 0;
  text-align: center;
}

page, .container {
  background: #f7f7f7;
}

.task-tip {
  padding: 24rpx 30rpx;
  font-size: 24rpx;
  color: #999;
}

.task-list {
  padding: 0 20rpx;
}

.task-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.task-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.task-icon image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.task-points {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #fd4a5f;
}

.task-action {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.btn-receive {
  background: linear-gradient(90deg, #ff7e5f, #fd4a5f);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
}

.btn-received {
  background: #eee;
  color: #999;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
}

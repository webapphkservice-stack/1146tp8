/* common.wxss */

/* 文章组（瀑布流） */

.diy-article {
  background: #f7f7f7;
  padding: 16rpx;
}

.diy-article .waterfall {
  display: flex;
  align-items: flex-start;
}

.diy-article .waterfall__col {
  flex: 1;
  width: 50%;
}

.diy-article .waterfall__col:first-child {
  margin-right: 16rpx;
}

.diy-article .article-card {
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.diy-article .article-card__image .image {
  display: block;
  width: 100%;
}

.diy-article .article-card__body {
  padding: 16rpx 20rpx 20rpx;
}

.diy-article .article-card__title {
  min-height: 72rpx;
  line-height: 1.4;
}

.diy-article .article-card__summary {
  margin-top: 8rpx;
  line-height: 1.4;
}

.diy-article .article-card__footer {
  margin-top: 12rpx;
}

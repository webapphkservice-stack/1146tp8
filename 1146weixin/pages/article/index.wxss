page {
  background: #f6f6f6;
}

.container {
  padding: 0 16rpx;
}

/* ===== 分类卡片按钮 ===== */
.cate-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f6f6f6;
  padding: 16rpx 0 8rpx;
}
.cate-scroll {
  width: 100%;
  white-space: nowrap;
}
.cate-row {
  display: inline-flex;
  align-items: center;
  padding: 0 8rpx;
}
.cate-card {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 64rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #ececec;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.cate-card.active {
  background: linear-gradient(135deg, #ff6a6c, #ff3d3f);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}

/* ===== 双排瀑布流 ===== */
.waterfall {
  display: flex;
  align-items: flex-start;
  padding-top: 16rpx;
}
.wf-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.wf-col:first-child {
  margin-right: 16rpx;
}

.article-card {
  display: block;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card-cover .image {
  width: 100%;
  display: block;
  background: #f0f0f0;
}
.card-body {
  padding: 16rpx 18rpx 18rpx;
}
.card-title {
  font-size: 28rpx;
  line-height: 1.4;
  color: #222;
  font-weight: 600;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #888;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-foot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #aaa;
}

.loading,
.no-more,
.null {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
.flow {
  height: 20rpx;
}

page {
  background: #f7f7f7;
}

.container {
  padding-bottom: 140rpx;
}

/* 加载中 / 空状态 */
.loading-box,
.empty-box {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-box .btn-home {
  width: 240rpx;
  margin: 40rpx auto 0;
  padding: 16rpx 0;
  border: 1rpx solid #fd4a5f;
  border-radius: 40rpx;
  color: #fd4a5f;
  font-size: 28rpx;
}

/* 下单人信息 */
.buyer-card {
  padding: 50rpx 30rpx 40rpx;
  background: #fff;
  text-align: center;
}

.buyer-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.buyer-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #333;
}

.buyer-name {
  font-weight: bold;
}

.pay-state {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.pay-state.success {
  color: #09bb07;
}

.pay-state.success .iconfont {
  margin-right: 8rpx;
}

.pay-state.paid {
  color: #999;
}

/* 商品卡片 */
.goods-card {
  margin-top: 20rpx;
  padding: 24rpx 30rpx;
  background: #fff;
}

.card-title {
  padding-bottom: 20rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-image image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.goods-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-attr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.goods-price-num {
  margin-top: auto;
  font-size: 26rpx;
}

.goods-num {
  color: #999;
}

.goods-price {
  color: #fd4a5f;
}

/* 订单信息 */
.order-info {
  padding-top: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.order-info-item {
  padding: 6rpx 0;
}

.order-info-item .label {
  color: #999;
}

/* 支付金额 */
.amount-card {
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
  background: #fff;
  font-size: 28rpx;
  color: #333;
}

.amount-card .amount {
  color: #fd4a5f;
  font-size: 34rpx;
  font-weight: bold;
}

/* 底部操作栏 */
.footer-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-pay {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(to right, #f9211c, #ff6335);
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
}

.btn-pay.gray {
  background: #ccc;
}

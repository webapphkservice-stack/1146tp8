/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  margin-bottom: 50rpx;
  padding: 0 10rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
  font-weight: 400;
}

/* 信息卡片 */
.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
}

.info-card:active {
  transform: scale(0.98);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
}

/* 卡片内容 */
.card-content {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

/* 头像按钮 */
.avatar-btn {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  padding: 0;
  margin: 20rpx 0;
  background: transparent;
  border: 6rpx solid #f0f0f0;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.avatar-btn::after {
  border: none;
}

.avatar-image {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: block;
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar-overlay .iconfont {
  color: #fff;
  font-size: 40rpx;
}

/* 昵称输入框 */
.nickname-input {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.nickname-input:focus {
  background: #fff;
  border-color: #ff6b6b;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 107, 0.1);
}

.nickname-input::placeholder {
  color: #bbb;
}

/* 提示信息 */
.tips-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
  padding: 30rpx;
  background: rgba(255, 193, 7, 0.1);
  border-radius: 16rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #999;
}

/* 昵称显示区域 */
.nickname-display {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #bbb;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nickname-display.has-value {
  color: #333;
}

/* 手机号码显示区域 */
.mobile-display {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #bbb;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mobile-display.has-value {
  color: #333;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 弹窗内容 */
.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  z-index: 1001;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-content.show {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%) scale(1);
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

/* 弹窗主体 */
.modal-body {
  padding: 40rpx;
}

.modal-input {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.modal-input:focus {
  border-color: #ff6b6b;
  background: #fff;
}

.modal-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 弹窗底部 */
.modal-footer {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  margin: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
}

/* 微信绑定 */
.bind-content {
  justify-content: space-between;
  padding: 10rpx 0;
}

.bind-status {
  font-size: 30rpx;
  color: #bbb;
}

.bind-status.bound {
  color: #07c160;
}

.bind-btn {
  margin: 0;
  padding: 0 36rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #07c160, #10ad62);
  border-radius: 32rpx;
  border: none;
}

.bind-btn::after {
  border: none;
}

/* 绑定手机号弹窗 */
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.code-input {
  flex: 1;
  margin-bottom: 0;
}

.code-btn {
  flex-shrink: 0;
  width: 210rpx;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #07c160, #10ad62);
  border-radius: 16rpx;
  border: none;
}

.code-btn::after {
  border: none;
}

.code-btn.disabled {
  background: #c8c9cc;
  color: #fff;
}

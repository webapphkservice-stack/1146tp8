.container {
  padding: 20rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

/* 店铺信息头部 */
.shop-detail-header {
  display: flex;
  background: linear-gradient(135deg, #ff7000, #ffa040);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  color: #fff;
}

.shop-detail-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.shop-detail-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.shop-detail-name {
  font-size: 34rpx;
  font-weight: 600;
}

.shop-detail-desc {
  font-size: 24rpx;
  opacity: 0.92;
  margin: 8rpx 0 12rpx;
  line-height: 1.5;
}

.shop-detail-row {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.shop-detail-label {
  flex-shrink: 0;
  opacity: 0.85;
  width: 130rpx;
}

.shop-detail-text {
  flex: 1;
}

.shop-wa {
  font-weight: 600;
  text-decoration: underline;
}

/* 外送商品列表 */
.goods-section {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.goods-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.goods-empty {
  font-size: 24rpx;
  color: #999;
  padding: 30rpx 0;
  text-align: center;
}

.goods-card {
  display: flex;
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.goods-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0 12rpx;
  line-height: 1.5;
}

.goods-range {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.goods-range-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  width: 100%;
}

.range-box {
  display: flex;
  flex-wrap: wrap;
  overflow: hidden;
}

.range-box.collapsed {
  max-height: 72rpx;
}

.goods-range-tag {
  font-size: 22rpx;
  color: #666;
  background: #f0f0f0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin: 0 8rpx 8rpx 0;
}

.goods-range-toggle {
  font-size: 22rpx;
  color: #ff9500;
  background: #fff4e5;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin: 0 8rpx 8rpx 0;
}

.goods-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.goods-price {
  color: #ff495e;
  font-weight: 600;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.goods-fee {
  font-size: 22rpx;
  color: #999;
  margin-right: 16rpx;
}

.goods-min {
  font-size: 22rpx;
  color: #999;
}

.goods-order {
  margin-top: 16rpx;
  background: #ff495e;
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  border-radius: 40rpx;
  padding: 16rpx 0;
}

/* 接单/配送状态徽标 */
.shop-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 14rpx;
  vertical-align: middle;
}

.badge-stop {
  color: #ff495e;
  background: #ffe9ec;
}

.badge-self {
  color: #ff9500;
  background: #fff4e5;
}

.goods-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #ff9500;
  background: #fff4e5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.goods-order.disabled {
  background: #ccc;
  color: #fff;
}

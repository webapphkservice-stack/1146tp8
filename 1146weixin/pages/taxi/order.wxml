<view class="container">
  <view class="taxi-header">
    <view class="taxi-title">我的出租车订单</view>
    <view class="taxi-sub">共 {{list.length}} 条预约记录</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <block wx:for="{{list}}" wx:key="order_id">
      <view class="order-card">
        <view class="order-top">
          <text class="order-no">{{item.order_no}}</text>
          <text class="order-status status-{{item.status}}">{{item.status_text}}</text>
        </view>
        <view class="order-row">
          <text class="order-label">抵达机场</text>
          <text class="order-value">{{item.airport_name}}</text>
        </view>
        <view class="order-row">
          <text class="order-label">车型</text>
          <text class="order-value">{{item.car_type_text}}</text>
        </view>
        <view class="order-row">
          <text class="order-label">价格</text>
          <text class="order-price">{{item.currency}} {{item.price}}</text>
        </view>
        <view class="order-row">
          <text class="order-label">航班号</text>
          <text class="order-value">{{item.flight_no}}</text>
        </view>
        <view class="order-row">
          <text class="order-label">出发 / 起飞 / 降落</text>
          <text class="order-value">{{item.departure_time || '—'}} / {{item.takeoff_time || '—'}} / {{item.landing_time || '—'}}</text>
        </view>
        <view class="order-row">
          <text class="order-label">酒店</text>
          <text class="order-value">{{item.hotel_name || '—'}}</text>
        </view>
        <view class="order-row" wx:if="{{item.hotel_address}}">
          <text class="order-label">酒店地址</text>
          <text class="order-value">{{item.hotel_address}}</text>
        </view>
        <view class="order-time">下单时间：{{item.create_time_text}}</view>
      </view>
      <view class="dispatch-card" wx:if="{{item.dispatch_car_arr && (item.dispatch_car_arr.type || item.dispatch_car_arr.number)}}">
        <view class="dc-title">本单派车</view>
        <view class="dc-info">{{item.dispatch_car_arr.type}} {{item.dispatch_car_arr.brand}} {{item.dispatch_car_arr.number}}<block wx:if="{{item.dispatch_car_arr.whatsapp}}">（司机WA:{{item.dispatch_car_arr.whatsapp}}）</block></view>
      </view>
    </block>
  </block>

  <view wx:elif="{{!loading}}" class="empty">暂无出租车订单</view>

  <view class="submit-btn" bindtap="goCreate">去预约出租车</view>
</view>

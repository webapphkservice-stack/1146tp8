/* 胶囊菜单 */
.capsule-menu {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 10px;
  padding-right: 10px;
  box-sizing: border-box;
}

/* 胶囊按钮组 */
.capsule-group {
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  margin-right: 20rpx;
}

/* 胶囊按钮项 */
.capsule-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.capsule-item .iconfont {
  font-size: 36rpx;
  color: #333;
}

/* 页面标题 */
.page-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capsule-container {
  pointer-events: auto; /* 恢复胶囊按钮的点击 */
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.capsule-left,
.capsule-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.capsule-left .iconfont {
  font-size: 36rpx;
  color: #333;
}

.capsule-right .iconfont {
  font-size: 36rpx;
  color: #666;
}

.capsule-divider {
  width: 1rpx;
  height: 60%;
  background: rgba(0, 0, 0, 0.1);
}

/* 用户头像 */
.user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}


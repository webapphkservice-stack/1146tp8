<view class="container">
  <view class="vip-order-list">
    <view wx:for="{{ list }}" wx:key="order_id" class="order-item b-f">
      <view class="order-item-top dis-flex flex-x-between flex-y-center">
        <text class="order-no f-24 col-9">订单号：{{ item.order_no }}</text>
        <text class="order-status f-24 {{ item.pay_status == 20 ? 'col-green' : 'col-orange' }}">{{ item.pay_status_text }}</text>
      </view>
      <view class="order-item-body dis-flex flex-x-between flex-y-center">
        <view class="order-plan">
          <view class="plan-name f-30 col-3">{{ item.plan_name }}</view>
          <view class="plan-paytype f-24 col-9">支付方式：{{ item.pay_type_name }}</view>
          <view class="plan-time f-22 col-9">下单：{{ item.create_time_text }}</view>
        </view>
        <view class="order-amount">
          <text class="f-24 col-m">￥</text>
          <text class="f-40 col-m">{{ item.pay_price }}</text>
        </view>
      </view>
      <view class="order-item-foot f-22 col-9">
        VIP到期：{{ item.expire_text }}
      </view>
    </view>

    <!-- 没有记录 -->
    <view class="yoshop-notcont" wx:if="{{ !list.length && !isLoading }}">
      <text class="iconfont icon-wushuju"></text>
      <text class="cont">亲，暂无VIP开通订单哦</text>
    </view>
  </view>
</view>

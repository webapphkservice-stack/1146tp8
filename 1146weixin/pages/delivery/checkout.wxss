.container {
  padding: 20rpx 24rpx 140rpx;
}

.block {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.block-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.loading {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

.service-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.service-row .label {
  width: 140rpx;
  color: #999;
}

.service-row .value {
  flex: 1;
  color: #333;
}

.address-card {
  position: relative;
  background: #fff6f7;
  border: 2rpx solid #ff495e;
  border-radius: 10rpx;
  padding: 20rpx;
}

.address-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.address-detail {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  line-height: 1.4;
  padding-right: 130rpx;
}

.address-change {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ff495e;
  font-size: 24rpx;
}

.address-empty {
  padding: 30rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  background: #fafafa;
  border-radius: 10rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}

.amount-row.total {
  font-weight: bold;
  color: #333;
  border-top: 2rpx solid #f0f0f0;
  margin-top: 8rpx;
  padding-top: 16rpx;
}

.amount-num {
  color: #333;
}

.remark-input {
  width: 100%;
  height: 120rpx;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 配送范围 */
.range-box {
  display: flex;
  flex-wrap: wrap;
  overflow: hidden;
}

.range-box.collapsed {
  max-height: 72rpx;
}

.range-tag {
  font-size: 22rpx;
  color: #666;
  background: #f0f0f0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin: 0 8rpx 8rpx 0;
}

.range-toggle {
  display: inline-block;
  font-size: 22rpx;
  color: #ff9500;
  background: #fff4e5;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-top: 4rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
}

.footer-total {
  font-size: 26rpx;
  color: #666;
}

.footer-price {
  color: #ff495e;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-submit {
  background: #ff495e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 0 60rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
}

.btn-submit[loading] {
  opacity: 0.7;
}
